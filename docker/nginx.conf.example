# nginx in front of LocalApp at https://miniserver.local/localapp
#
# proxy_pass has no URI part, so the full /localapp/... path reaches LocalApp
# (LOCALAPP_BASE_PATH=/localapp).

server {
    listen 443 ssl;
    server_name miniserver.local;

    ssl_certificate     /etc/nginx/certs/miniserver.local.crt;
    ssl_certificate_key /etc/nginx/certs/miniserver.local.key;

    location /localapp {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # Largest request body the app accepts.
        client_max_body_size 10m;
    }
}
